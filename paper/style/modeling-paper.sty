\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{modeling-paper.sty}[2026/08/26 Internal Huawei Cup modeling paper style]

\RequirePackage{geometry}
\geometry{a4paper,left=2.54cm,right=2.54cm,top=2.54cm,bottom=2.54cm}
\RequirePackage{setspace}
\setstretch{1.0}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{pdfpages}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{cleveref}

\hypersetup{
  hidelinks,
  pdftitle={数学建模论文模板},
  pdfauthor={},
  pdfsubject={Internal template; replace with current official profile}
}

% No header; centered continuous footer page number.
\pagestyle{fancy}
\fancyhf{}
\cfoot{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\cfoot{\thepage}\renewcommand{\headrulewidth}{0pt}}

\ctexset{
  section = {format=\centering\heiti\zihao{4},beforeskip=1.2ex,afterskip=0.8ex},
  subsection = {format=\heiti\zihao{-4},beforeskip=1.0ex,afterskip=0.5ex},
  subsubsection = {format=\heiti\zihao{-4},beforeskip=0.8ex,afterskip=0.3ex}
}
\captionsetup{font=small,labelfont=bf}
\floatstyle{plain}
\setlist{nosep,leftmargin=2em}

\newcommand{\PaperCover}{%
  \ifPaperUseOfficialCover
    \IfFileExists{\PaperOfficialCoverPath}{%
      \includepdf[pages=\PaperOfficialCoverPages]{\PaperOfficialCoverPath}%
    }{%
      \PackageWarning{modeling-paper}{Official cover not found; using internal placeholder}%
      \PaperInternalCover
    }%
  \else
    \PaperInternalCover
  \fi
}

\newcommand{\PaperInternalCover}{%
  \thispagestyle{empty}
  \begin{center}
    \vspace*{0.20\textheight}
    {\heiti\zihao{2} 数学建模论文内部模板}\par
    \vspace{2em}
    {\zihao{3} 内部编译示例，不得直接作为参赛封面}\par
    \vspace{3em}
    {\zihao{4} 官方版本：\PaperOfficialYear}\par
    \vfill
    {\zihao{-4} 正式提交前必须替换为当届官方封面和统一摘要页}\par
  \end{center}
  \clearpage
}

\newenvironment{abstractpage}{%
  \thispagestyle{plain}
  \begin{center}
    {\heiti\zihao{3} \PaperTitle\par}
    \vspace{1em}
    {\heiti\zihao{4} 摘要\par}
  \end{center}
  \vspace{0.5em}
}{%
  \par\vspace{0.5em}
  \noindent{\heiti\zihao{-4} 关键词：}\PaperKeywords\par
  \clearpage
}

\newcommand{\paperexample}[1]{\textcolor{gray}{\emph{模板示例：#1}}}
