% 工作台专用的少量辅助宏。
%
% 封面、承诺书、摘要版式、页码规则、匿名要求全部由 gmcmthesis 文档类负责，
% 本文件不再重复实现 —— 那些是当届官方格式的一部分，社区文档类已经跟进，
% 我们自己维护一套只会和官方要求漂移。

\ProvidesPackage{modeling-paper}[2026/08/29 workbench helpers for gmcmthesis]

% gmcmthesis 已加载 booktabs、longtable、makecell、multirow、tabularx、caption、
% subcaption、listings、enumitem、amsmath 等。这里只补它没有、而章节确实要用的：
\RequirePackage{float}          % table[H] / figure[H] 精确定位

% 子图。文档类里 subcaption 是被注释掉的（上游示例改用 subfig），所以必须在这里
% 显式加载。两者互斥：从 paper/upstream/example.tex 抄子图代码时要改写成
% subcaption 的 subfigure 环境，不能直接 \usepackage{subfig}。
\RequirePackage{subcaption}

% 伪代码。建模论文几乎必然要写算法，文档类没有提供，所以在这里统一加载并汉化，
% 避免每位作者各写一套 \renewcommand 导致同一篇论文里「输入/Require」混用。
\RequirePackage{algorithm}
\RequirePackage[noend]{algpseudocode}
\floatname{algorithm}{算法}
\renewcommand{\algorithmicrequire}{\textbf{输入：}}
\renewcommand{\algorithmicensure}{\textbf{输出：}}

% 代码清单。文档类已加载 listings，这里只定义 Python / MATLAB 两种语言的统一样式，
% 供附录使用。关键是 extendedchars + 中文字体，否则注释里的中文会掉字。
\lstdefinestyle{modelingcode}{
  basicstyle       = \ttfamily\footnotesize,
  keywordstyle     = \color[rgb]{0.13,0.29,0.53}\bfseries,
  commentstyle     = \color[rgb]{0.36,0.54,0.36}\itshape,
  stringstyle      = \color[rgb]{0.63,0.16,0.16},
  numbers          = left,
  numberstyle      = \tiny\color{gray},
  numbersep        = 8pt,
  frame            = single,
  rulecolor        = \color{gray!40},
  breaklines       = true,
  breakatwhitespace= false,
  showstringspaces = false,
  tabsize          = 4,
  columns          = flexible,
  extendedchars    = true,
  escapeinside     = {(*@}{@*)},
}
\lstset{style=modelingcode}
%
% 其余包按需在各自章节 \usepackage。amsthm 会与文档类的 \proof 冲突；
% siunitx、tikz、colortbl 目前无人使用，不预先塞进来。

% 模板示例标记。正式论文里不应残留任何 \paperexample —— make paper-ci 会检查。
\newcommand{\paperexample}[1]{\textcolor{gray}{\emph{模板示例：#1}}}

% 数字溯源标记：把正文里的数字与实验 ID 绑在一起，便于写作手自查和 C3 抽查。
% 用法：本文在 12 个算例上均可行\dataref{EXP-OPT-002}。
% 默认不打印，只在草稿模式下显示；提交稿不受影响。
\newif\ifPaperDraftRefs
\PaperDraftRefsfalse
\newcommand{\dataref}[1]{\ifPaperDraftRefs\textsuperscript{\textcolor{gray}{\scriptsize[#1]}}\fi}
