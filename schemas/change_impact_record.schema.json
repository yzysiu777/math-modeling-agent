{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/change_impact_record.json",
  "type": "object",
  "required": [
    "record_type", "revision_id", "case_id", "base_git_revision", "new_git_revision",
    "approval_id", "source_review_id", "finding_ids", "change_level", "change_surfaces",
    "changed_files", "before_hashes", "after_hashes", "affected_gates", "gate_impact",
    "affected_claims", "affected_experiments", "affected_figures", "required_checks",
    "required_review_nodes", "candidate_submission_pdf", "candidate_pdf_path", "candidate_pdf_sha256",
    "unresolved_findings", "modified_by", "executor_id", "validation_status",
    "project_manifest_path", "project_manifest_sha256", "review_bindings"
  ],
  "properties": {
    "record_type": {"const": "change_impact_record"},
    "revision_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "base_git_revision": {"type": "string", "minLength": 1},
    "new_git_revision": {"type": "string", "minLength": 1},
    "approval_id": {"type": ["string", "null"]},
    "source_review_id": {"type": ["string", "null"]},
    "finding_ids": {"type": "array", "items": {"type": "string"}},
    "change_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "change_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["text_only", "paper_claim", "code_only", "experiment_logic", "data_contract", "model_formula", "objective_constraint", "candidate_pdf"]}},
    "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "before_hashes": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, {"type": "null"}]}},
    "after_hashes": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, {"type": "null"}]}},
    "affected_gates": {"type": "array", "items": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"}},
    "gate_impact": {"type": "string", "enum": ["no_gate_impact", "affected"]},
    "affected_claims": {"type": "array", "items": {"type": "string"}},
    "affected_experiments": {"type": "array", "items": {"type": "string"}},
    "affected_figures": {"type": "array", "items": {"type": "string"}},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_review_nodes": {"type": "array", "items": {"type": "string", "enum": ["C1", "C2", "C3"]}},
    "candidate_submission_pdf": {"type": "boolean"},
    "candidate_pdf_path": {"type": ["string", "null"]},
    "candidate_pdf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "statement"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "statement": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "modified_by": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "project_manifest_path": {"type": ["string", "null"]},
    "project_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "review_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "review_id", "path", "sha256", "case_id", "target_revision", "input_hashes", "reviewer_id", "reviewer_role"],
        "properties": {
          "node": {"type": "string", "enum": ["C1", "C2", "C3"]},
          "review_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "case_id": {"type": "string", "minLength": 1},
          "target_revision": {"type": "string", "minLength": 1},
          "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
          "reviewer_id": {"type": "string", "minLength": 1},
          "reviewer_role": {"type": "string", "enum": ["independent_adversary", "independent_reviewer", "human"]}
        },
        "additionalProperties": false
      }
    },
    "validation_status": {"type": "string", "enum": ["pending", "passed", "failed"]}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_submission_pdf": {"const": true}}},
      "then": {
        "required": ["candidate_pdf_path", "candidate_pdf_sha256"],
        "properties": {
          "candidate_pdf_path": {"type": "string", "minLength": 1},
          "candidate_pdf_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
