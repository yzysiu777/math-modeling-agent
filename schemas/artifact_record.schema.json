{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/artifact_record.json",
  "type": "object",
  "required": ["record_type", "artifact_id", "case_id", "path", "kind", "sha256", "created_by", "status"],
  "properties": {
    "record_type": {"const": "artifact_record"},
    "artifact_id": {"type": "string"},
    "case_id": {"type": "string"},
    "path": {"type": "string"},
    "kind": {"type": "string", "enum": ["input", "source", "contract", "code", "experiment", "figure", "table", "review", "paper", "template", "other"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "created_by": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "frozen", "superseded", "approved", "rejected"]},
    "parents": {"type": "array", "items": {"type": "string"}},
    "sensitivity": {"type": "string", "enum": ["public", "team", "private"]}
  },
  "additionalProperties": false
}
