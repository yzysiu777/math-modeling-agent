{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/experiment_record.json",
  "type": "object",
  "required": ["record_type", "experiment_id", "case_id", "question", "objective", "input_manifest_hash", "code_revision", "environment", "command", "baseline_or_candidate", "metrics", "outputs", "review_status"],
  "properties": {
    "record_type": {"const": "experiment_record"},
    "experiment_id": {"type": "string"},
    "case_id": {"type": "string"},
    "question": {"type": "string"},
    "objective": {"type": "string"},
    "input_manifest_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "environment": {"type": "object", "required": ["os", "python", "packages", "solver"], "properties": {"os": {"type": "string"}, "python": {"type": "string"}, "packages": {"type": "array", "items": {"type": "string"}}, "solver": {"type": "string"}}, "additionalProperties": false},
    "random_seed": {"type": ["integer", "null"]},
    "command": {"type": "string"},
    "parameters": {"type": "object"},
    "baseline_or_candidate": {"type": "string", "enum": ["baseline", "candidate", "ablation", "sensitivity", "reproduction"]},
    "metrics": {"type": "object"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "failure_or_deviation": {"type": "string"},
    "review_status": {"type": "string", "enum": ["pending", "accepted", "rejected"]}
  },
  "additionalProperties": false
}
