{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/manual_attestation.json",
  "type": "object",
  "required": [
    "record_type", "attestation_id", "case_id", "revision_id", "check_id",
    "attestor_role", "attestor_id", "source_review_id", "evidence_artifacts",
    "signed_at", "decision", "executor_id", "modifier_id"
  ],
  "properties": {
    "record_type": {"const": "manual_attestation"},
    "attestation_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "check_id": {"type": "string", "minLength": 1},
    "attestor_role": {"type": "string", "enum": ["human_owner", "independent_adversary", "independent_reviewer"]},
    "attestor_id": {"type": "string", "minLength": 1},
    "source_review_id": {"type": "string", "minLength": 1},
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "kind": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "signed_at": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["passed", "accepted", "rejected"]},
    "executor_id": {"type": "string", "minLength": 1},
    "modifier_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
