{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/routing_record.json",
  "type": "object",
  "required": ["record_type", "routing_id", "case_id", "route", "evidence", "alternatives_considered", "uncertainty", "decided_by", "decided_at"],
  "properties": {
    "record_type": {"const": "routing_record"},
    "routing_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string"},
    "route": {"type": "string", "enum": ["optimization", "data_analysis", "hybrid", "insufficient_information"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "alternatives_considered": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "decided_by": {"type": "string"},
    "decided_at": {"type": "string"},
    "human_confirmation_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
