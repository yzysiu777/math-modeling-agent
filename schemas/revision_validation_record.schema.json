{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/revision_validation_record.json",
  "type": "object",
  "$defs": {
    "check_result": {
      "type": "object",
      "required": [
        "check_id", "status", "execution_kind", "executor", "started_at", "finished_at",
        "exit_code", "stdout_path", "stdout_sha256", "stderr_path", "stderr_sha256", "artifact_hashes"
      ],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["passed", "failed", "manual_required", "not_implemented"]},
        "execution_kind": {"type": "string", "enum": ["trusted_runner", "human_attestation"]},
        "executor": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "minLength": 1},
        "finished_at": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_path": {"type": "string", "minLength": 1},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "stderr_path": {"type": "string", "minLength": 1},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
        "attestation_path": {"type": ["string", "null"]},
        "attestation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "closed_finding": {
      "type": "object",
      "required": [
        "finding_id", "severity", "source_review_id", "raised_by", "raised_by_id",
        "modified_by", "modified_by_id", "closed_by", "closed_by_id", "closure_evidence"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "source_review_id": {"type": "string", "minLength": 1},
        "raised_by": {"type": "string", "minLength": 1},
        "raised_by_id": {"type": "string", "minLength": 1},
        "modified_by": {"type": "string", "minLength": 1},
        "modified_by_id": {"type": "string", "minLength": 1},
        "closed_by": {"type": "string", "minLength": 1},
        "closed_by_id": {"type": "string", "minLength": 1},
        "closure_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "record_type", "revision_id", "case_id", "approval_id", "source_review_id", "finding_ids",
    "base_git_revision", "new_git_revision", "change_level", "change_surfaces", "changed_files",
    "evidence_root", "runner_id", "runner_version", "runner_script", "runner_script_sha256",
    "execution_started_at", "execution_finished_at", "check_results", "output_hashes", "new_experiment_ids",
    "claim_status_updates", "closed_findings", "unresolved_findings", "validator", "validation_status"
  ],
  "properties": {
    "record_type": {"const": "revision_validation_record"},
    "revision_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": ["string", "null"]},
    "source_review_id": {"type": ["string", "null"]},
    "finding_ids": {"type": "array", "items": {"type": "string"}},
    "base_git_revision": {"type": "string", "minLength": 1},
    "new_git_revision": {"type": "string", "minLength": 1},
    "change_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "change_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["text_only", "paper_claim", "code_only", "experiment_logic", "data_contract", "model_formula", "objective_constraint", "candidate_pdf"]}},
    "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_root": {"type": "string", "minLength": 1},
    "runner_id": {"type": "string", "minLength": 1},
    "runner_version": {"type": "string", "minLength": 1},
    "runner_script": {"type": "string", "minLength": 1},
    "runner_script_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "execution_started_at": {"type": "string", "minLength": 1},
    "execution_finished_at": {"type": "string", "minLength": 1},
    "check_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check_result"}},
    "output_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
    "new_experiment_ids": {"type": "array", "items": {"type": "string"}},
    "claim_status_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "status"],
        "properties": {
          "claim_id": {"type": "string"},
          "status": {"type": "string", "enum": ["downgraded", "revalidated"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "closed_findings": {"type": "array", "items": {"$ref": "#/$defs/closed_finding"}},
    "unresolved_findings": {"type": "array", "items": {"type": "string"}},
    "validator": {"type": "string", "minLength": 1},
    "validation_status": {"type": "string", "enum": ["pending", "passed", "failed"]}
  },
  "additionalProperties": false
}
