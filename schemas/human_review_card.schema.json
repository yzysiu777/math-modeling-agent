{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/human_review_card.json",
  "type": "object",
  "required": [
    "record_type", "critical_node", "decision_id", "decision_needed", "why_it_matters",
    "current_choice", "alternatives", "key_assumptions", "hard_constraints",
    "one_key_formula_or_diagram", "deterministic_evidence", "claude_challenge_summary",
    "main_risk", "recommended_choice", "human_checked", "human_not_checked",
    "expertise_limitations", "decision", "required_followup", "signer", "timestamp"
  ],
  "properties": {
    "record_type": {"const": "human_review_card"},
    "critical_node": {"type": "string", "enum": ["C1", "C2", "C3"]},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_needed": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "current_choice": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "key_assumptions": {"type": "array", "items": {"type": "string"}},
    "hard_constraints": {"type": "array", "items": {"type": "string"}},
    "one_key_formula_or_diagram": {"type": "string", "minLength": 1},
    "deterministic_evidence": {"type": "array", "items": {"type": "string"}},
    "claude_challenge_summary": {"type": "string", "minLength": 1},
    "main_risk": {"type": "string", "minLength": 1},
    "recommended_choice": {"type": "string", "minLength": 1},
    "human_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_not_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expertise_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision": {"type": "string", "enum": ["accept", "reject", "revise", "escalate"]},
    "required_followup": {"type": "array", "items": {"type": "string"}},
    "signer": {"type": "string"},
    "timestamp": {"type": "string"}
  },
  "additionalProperties": false
}
