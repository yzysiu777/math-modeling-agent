{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/approved_findings.json",
  "type": "object",
  "$defs": {
    "input_binding": {
      "type": "object",
      "required": ["path", "sha256", "artifact_kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "artifact_kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "review_binding": {
      "type": "object",
      "required": ["node", "review_id", "path", "sha256", "case_id", "target_revision", "target_git_revision", "input_bindings", "reviewer_id", "reviewer_role"],
      "properties": {
        "node": {"type": "string", "enum": ["C1", "C2", "C3"]},
        "review_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "case_id": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "target_git_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "input_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input_binding"}},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "enum": ["independent_adversary", "independent_reviewer", "human"]}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "record_type", "approval_id", "case_id", "review_id", "approver", "approver_id", "approver_role", "approved_at", "expires_at",
    "finding_ids", "revision_id", "base_git_revision", "new_git_revision", "change_level",
    "change_surfaces", "affected_gates", "gate_impact", "allowed_files", "forbidden_files", "validation_check_ids",
    "required_review_nodes", "review_bindings", "candidate_submission_pdf", "candidate_pdf_path", "candidate_pdf_sha256", "executor_id", "modified_by", "project_manifest_path", "project_manifest_sha256", "status"
  ],
  "properties": {
    "record_type": {"const": "approved_findings"},
    "approval_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "approver_id": {"type": "string", "minLength": 1},
    "approver_role": {"const": "human_owner"},
    "approved_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "revision_id": {"type": "string", "minLength": 1},
    "base_git_revision": {"type": "string", "minLength": 1},
    "new_git_revision": {"type": "string", "minLength": 1},
    "change_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "change_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["text_only", "paper_claim", "code_only", "experiment_logic", "data_contract", "model_formula", "objective_constraint", "candidate_pdf"]}},
    "affected_gates": {"type": "array", "items": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"}},
    "gate_impact": {"type": "string", "enum": ["no_gate_impact", "affected"]},
    "allowed_files": {"type": "array", "items": {"type": "string"}},
    "forbidden_files": {"type": "array", "items": {"type": "string"}},
    "validation_check_ids": {"type": "array", "items": {"type": "string"}},
    "required_review_nodes": {"type": "array", "items": {"type": "string", "enum": ["C1", "C2", "C3"]}},
    "review_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "#/$defs/review_binding"
      }
    },
    "candidate_submission_pdf": {"type": "boolean"},
    "candidate_pdf_path": {"type": ["string", "null"]},
    "candidate_pdf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "executor_id": {"type": "string", "minLength": 1},
    "modified_by": {"type": "string", "minLength": 1},
    "project_manifest_path": {"type": "string", "minLength": 1},
    "project_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "status": {"type": "string", "enum": ["draft", "approved", "applied", "rejected", "expired"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["approved", "applied"]}}},
      "then": {
        "properties": {
          "allowed_files": {"minItems": 1},
          "validation_check_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"candidate_submission_pdf": {"const": true}}},
      "then": {
        "required": ["candidate_pdf_path", "candidate_pdf_sha256"],
        "properties": {
          "candidate_pdf_path": {"type": "string", "minLength": 1},
          "candidate_pdf_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    }
  ],
  "additionalProperties": false
}
