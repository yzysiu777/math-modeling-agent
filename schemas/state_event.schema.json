{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/state_event.json",
  "type": "object",
  "required": ["record_type", "event_id", "case_id", "from_state", "to_state", "actor", "reason", "evidence", "timestamp"],
  "properties": {
    "record_type": {"const": "state_event"},
    "event_id": {"type": "string"},
    "case_id": {"type": "string"},
    "from_state": {"type": "string", "enum": ["intake", "routed", "frozen", "contracted", "baseline_ready", "model_ready", "validated", "results_verified", "reviewed", "gate_passed", "paper_ready", "format_checked", "pdf_qa_passed", "human_frozen", "revision_pending", "impact_classified", "targeted_validation", "validation_passed", "validation_failed", "restore_affected_gate"]},
    "to_state": {"type": "string", "enum": ["intake", "routed", "frozen", "contracted", "baseline_ready", "model_ready", "validated", "results_verified", "reviewed", "gate_passed", "paper_ready", "format_checked", "pdf_qa_passed", "human_frozen", "revision_pending", "impact_classified", "targeted_validation", "validation_passed", "validation_failed", "restore_affected_gate"]},
    "actor": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string"},
    "supersedes_event_id": {"type": ["string", "null"]},
    "revision_id": {"type": ["string", "null"]},
    "change_level": {"type": ["string", "null"], "enum": ["R0", "R1", "R2", "R3", null]},
    "change_surfaces": {"type": "array", "items": {"type": "string", "enum": ["text_only", "paper_claim", "code_only", "experiment_logic", "data_contract", "model_formula", "objective_constraint", "candidate_pdf"]}},
    "affected_gates": {"type": "array", "items": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"}},
    "gate_impact": {"type": ["string", "null"], "enum": ["no_gate_impact", "affected", null]},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "validation_status": {"type": ["string", "null"], "enum": ["pending", "passed", "failed", null]},
    "closure_id": {"type": ["string", "null"]},
    "closure_path": {"type": ["string", "null"]},
    "closure_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "gate_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
  },
  "allOf": [
    {
      "if": {"properties": {"to_state": {"enum": ["validation_passed", "restore_affected_gate"]}}},
      "then": {"required": ["closure_id", "closure_path", "closure_sha256"]}
    },
    {
      "if": {"properties": {"from_state": {"const": "restore_affected_gate"}}},
      "then": {"required": ["closure_id", "closure_path", "closure_sha256"]}
    }
  ],
  "additionalProperties": false
}
