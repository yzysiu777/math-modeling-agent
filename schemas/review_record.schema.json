{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/review_record.json",
  "type": "object",
  "$defs": {
    "disconfirming_test": {
      "type": "object",
      "required": ["test_id", "target", "input_or_case", "expected_falsifier", "actual_result", "evidence", "status"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "input_or_case": {"type": "string", "minLength": 1},
        "expected_falsifier": {"type": "string", "minLength": 1},
        "actual_result": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["planned", "passed", "failed", "blocked"]}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id", "severity", "statement", "evidence", "impact", "recommended_action",
        "resolved", "raised_by", "raised_by_id", "source_review_id", "modified_by", "modified_by_id",
        "closed_by", "closed_by_id", "closure_evidence"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "statement": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "impact": {"type": "string", "minLength": 1},
        "recommended_action": {"type": "string", "minLength": 1},
        "resolved": {"type": "boolean"},
        "raised_by": {"type": "string", "minLength": 1},
        "raised_by_id": {"type": "string", "minLength": 1},
        "source_review_id": {"type": "string", "minLength": 1},
        "modified_by": {"type": ["string", "null"]},
        "modified_by_id": {"type": ["string", "null"]},
        "closed_by": {"type": ["string", "null"]},
        "closed_by_id": {"type": ["string", "null"]},
        "closure_evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "record_type", "review_id", "case_id", "reviewer_role", "reviewer_id", "critical_node",
    "review_mode", "review_lens", "primary_method_family", "alternative_method_family",
    "methodological_difference", "critical_decisions_reviewed", "disconfirming_tests",
    "counterexamples", "what_was_checked", "what_was_not_checked", "human_decisions_required",
    "target_artifacts", "input_hashes", "verdict", "findings", "unresolved_questions", "uncertainty",
    "reviewer_signature", "created_at"
  ],
  "properties": {
    "record_type": {"const": "review_record"},
    "review_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "enum": ["independent_adversary", "human"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "critical_node": {"type": "string", "enum": ["C1", "C2", "C3"]},
    "review_mode": {"type": "string", "enum": ["blind", "challenge", "results"]},
    "review_lens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": [
        "semantic_constraint_audit", "alternative_formulation",
        "invariant_counterexample", "implementation_consistency", "evidence_claim_audit"
      ]}
    },
    "primary_method_family": {"type": "string", "enum": [
      "unknown", "other", "linear_programming", "mixed_integer_programming", "nonlinear_programming",
      "dynamic_programming", "shortest_path", "constraint_programming", "metaheuristic",
      "stochastic_programming", "robust_optimization", "simulation_optimization", "statistical_regression",
      "classification", "tree_ensemble", "neural_network", "time_series", "clustering",
      "causal_inference", "rule_based"
    ]},
    "alternative_method_family": {"type": "string", "enum": [
      "unknown", "other", "linear_programming", "mixed_integer_programming", "nonlinear_programming",
      "dynamic_programming", "shortest_path", "constraint_programming", "metaheuristic",
      "stochastic_programming", "robust_optimization", "simulation_optimization", "statistical_regression",
      "classification", "tree_ensemble", "neural_network", "time_series", "clustering",
      "causal_inference", "rule_based"
    ]},
    "methodological_difference": {
      "type": "object",
      "required": ["axis", "primary_assumption", "alternative_assumption", "discriminating_test"],
      "properties": {
        "axis": {"type": "string", "enum": ["decomposition", "relaxation", "feasibility", "invariant", "counterexample", "solver_paradigm", "data_split", "evidence_audit"]},
        "primary_assumption": {"type": "string", "minLength": 1},
        "alternative_assumption": {"type": "string", "minLength": 1},
        "discriminating_test": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "critical_decisions_reviewed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disconfirming_tests": {"type": "array", "items": {"$ref": "#/$defs/disconfirming_test"}},
    "counterexamples": {"type": "array", "items": {"$ref": "#/$defs/disconfirming_test"}},
    "what_was_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "what_was_not_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_decisions_required": {"type": "array", "items": {"type": "string"}},
    "target_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
    "verdict": {"type": "string", "enum": ["PASS", "PASS_WITH_LIMITATIONS", "BLOCKED", "REJECTED"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reviewer_signature": {"type": "string"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
