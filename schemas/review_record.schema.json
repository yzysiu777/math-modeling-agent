{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/review_record.json",
  "type": "object",
  "required": [
    "record_type", "review_id", "case_id", "reviewer_role", "critical_node",
    "review_mode", "review_lens", "primary_method_family", "alternative_method_family",
    "methodological_difference", "critical_decisions_reviewed", "disconfirming_tests",
    "counterexamples", "what_was_checked", "what_was_not_checked",
    "human_decisions_required", "target_artifacts", "input_hashes", "verdict",
    "findings", "unresolved_questions", "uncertainty", "reviewer_signature", "created_at"
  ],
  "properties": {
    "record_type": {"const": "review_record"},
    "review_id": {"type": "string"},
    "case_id": {"type": "string"},
    "reviewer_role": {"type": "string", "enum": ["independent_adversary", "human"]},
    "critical_node": {"type": "string", "enum": ["C1", "C2", "C3"]},
    "review_mode": {"type": "string", "enum": ["blind", "challenge", "results"]},
    "review_lens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": [
        "semantic_constraint_audit", "alternative_formulation",
        "invariant_counterexample", "implementation_consistency", "evidence_claim_audit"
      ]}
    },
    "primary_method_family": {"type": "string", "minLength": 1},
    "alternative_method_family": {"type": "string", "minLength": 1},
    "methodological_difference": {"type": "string", "minLength": 1},
    "critical_decisions_reviewed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disconfirming_tests": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "what_was_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "what_was_not_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_decisions_required": {"type": "array", "items": {"type": "string"}},
    "target_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verdict": {"type": "string", "enum": ["PASS", "PASS_WITH_LIMITATIONS", "BLOCKED", "REJECTED"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "statement", "evidence", "impact", "recommended_action", "resolved"],
        "properties": {
          "finding_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "statement": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "impact": {"type": "string"},
          "recommended_action": {"type": "string"},
          "resolved": {"type": "boolean"},
          "resolved_by": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reviewer_signature": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
