{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-modeling-agent.local/schema/work_item.json",
  "type": "object",
  "required": [
    "record_type", "work_item_id", "case_id", "source_git_revision", "objective", "scope", "non_goals",
    "allowed_files", "affected_claims", "affected_experiments", "affected_gates", "required_checks",
    "change_level", "change_surfaces", "required_review_nodes", "executor_id", "reviewer_id",
    "write_owner_id", "result_git_revision", "test_evidence", "status", "unresolved_items",
    "revision_id", "report_path", "human_decisions_required", "previous_status",
    "trusted_validation_record_path", "trusted_validation_record_sha256", "trusted_validation_record_id",
    "trusted_change_impact_path", "trusted_change_impact_sha256", "review_verdict_path",
    "review_verdict_sha256", "review_id", "reviewer_role"
  ],
  "properties": {
    "record_type": {"const": "work_item"},
    "work_item_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_git_revision": {"type": "string", "minLength": 7},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affected_claims": {"type": "array", "items": {"type": "string"}},
    "affected_experiments": {"type": "array", "items": {"type": "string"}},
    "affected_gates": {"type": "array", "items": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"}},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "change_level": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "change_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["text_only", "paper_claim", "code_only", "experiment_logic", "data_contract", "model_formula", "objective_constraint", "candidate_pdf"]}},
    "required_review_nodes": {"type": "array", "items": {"type": "string", "enum": ["C1", "C2", "C3"]}},
    "executor_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "write_owner_id": {"type": "string", "minLength": 1},
    "result_git_revision": {"type": ["string", "null"], "minLength": 7},
    "trusted_validation_record_path": {"type": ["string", "null"]},
    "trusted_validation_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "trusted_validation_record_id": {"type": ["string", "null"]},
    "trusted_change_impact_path": {"type": ["string", "null"]},
    "trusted_change_impact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "review_verdict_path": {"type": ["string", "null"]},
    "review_verdict_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "review_id": {"type": ["string", "null"]},
    "reviewer_role": {"type": ["string", "null"], "enum": ["independent_adversary", "independent_reviewer", "human", null]},
    "previous_status": {"type": ["string", "null"], "enum": ["proposed", "approved", "executing", "review_ready", "accepted", "revision_requested", "blocked", null]},
    "test_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "status", "evidence_path", "sha256"],
        "properties": {
          "check_id": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "manual_required"]},
          "evidence_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "status": {"type": "string", "enum": ["proposed", "approved", "executing", "review_ready", "accepted", "revision_requested", "blocked"]},
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "statement"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "statement": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "revision_id": {"type": "string", "minLength": 1},
    "report_path": {"type": ["string", "null"]},
    "human_decisions_required": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {
        "required": [
          "trusted_validation_record_path", "trusted_validation_record_sha256", "trusted_validation_record_id",
          "review_verdict_path", "review_verdict_sha256", "review_id", "reviewer_role"
        ],
        "properties": {
          "trusted_validation_record_path": {"type": "string", "minLength": 1},
          "trusted_validation_record_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "trusted_validation_record_id": {"type": "string", "minLength": 1},
          "review_verdict_path": {"type": "string", "minLength": 1},
          "review_verdict_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "review_id": {"type": "string", "minLength": 1},
          "reviewer_role": {"enum": ["independent_adversary", "independent_reviewer"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
